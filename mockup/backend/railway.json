{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "nixpacks",
    "buildCommand": "echo 'No build required for ultra-simple server'"
  },
  "deploy": {
    "startCommand": "node ultra-simple-server.js",
    "restartPolicyType": "on_failure",
    "restartPolicyMaxRetries": 10,
    "numReplicas": 1,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30,
    "region": "us-west1"
  },
  "env": {
    "NODE_ENV": "production",
    "PORT": {
      "$envVar": "PORT"
    },
    "LOG_LEVEL": {
      "$envVar": "LOG_LEVEL",
      "default": "info"
    },
    "ENABLE_MONITORING": {
      "$envVar": "ENABLE_MONITORING",
      "default": "true"
    },
    "HEALTH_CHECK_INTERVAL": {
      "$envVar": "HEALTH_CHECK_INTERVAL",
      "default": "30000"
    },
    "MAX_REQUEST_SIZE": {
      "$envVar": "MAX_REQUEST_SIZE",
      "default": "10mb"
    }
  }
}