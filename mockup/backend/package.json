{
  "name": "finding-sports-backend",
  "version": "1.0.0",
  "description": "Finding Sports backend with 10-agent scraping swarm",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "swarm": "node services/sports-scraping-swarm/deploy-swarm.js",
    "test": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "TEST_TYPE=integration jest tests/integration",
    "test:moderation": "jest tests/unit/moderation-permissions.test.js tests/integration/moderation-endpoints.test.js",
    "test:chat": "jest tests/unit/chat-room-lifecycle.test.js tests/unit/message-moderation.test.js",
    "test:security": "jest tests/integration/security-tests.test.js",
    "test:websocket": "jest tests/unit/websocket-events.test.js",
    "test:reports": "jest tests/unit/report-handling.test.js",
    "test:watch": "jest --watch",
    "test:ci": "jest --ci --coverage --maxWorkers=2",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "db:migrate": "node scripts/migrate-database.js",
    "db:seed": "node scripts/seed-database.js",
    "db:reset": "node scripts/reset-database.js",
    "db:backup": "node scripts/backup-database.js"
  },
  "keywords": [
    "sports",
    "scraping",
    "swarm",
    "recreation",
    "games"
  ],
  "author": "Finding Sports Team",
  "license": "MIT",
  "dependencies": {
    "@types/mapbox-gl": "^3.4.1",
    "axios": "^1.10.0",
    "bcrypt": "^5.1.1",
    "cheerio": "^1.0.0-rc.12",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-brute": "^1.0.1",
    "express-rate-limit": "^8.0.1",
    "express-slow-down": "^2.1.0",
    "express-validator": "^7.2.1",
    "geohash": "^0.0.1",
    "google-auth-library": "^9.2.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mapbox-gl": "^3.13.0",
    "morgan": "^1.10.1",
    "node-cron": "^3.0.2",
    "node-fetch": "^2.7.0",
    "socket.io": "^4.7.2",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.1",
    "superagent": "^8.1.2",
    "supertest": "^6.3.3",
    "uuid": "^9.0.1"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
