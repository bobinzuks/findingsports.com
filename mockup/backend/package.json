{
  "name": "finding-sports-backend",
  "version": "1.0.0",
  "description": "Finding Sports backend with 10-agent scraping swarm",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "swarm": "node services/sports-scraping-swarm/deploy-swarm.js",
    "test": "npm run test:unit && npm run test:swarm",
    "test:unit": "jest",
    "test:swarm": "node -e \"require('./integrate-swarm').testSwarm().catch(console.error)\"",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix"
  },
  "keywords": [
    "sports",
    "scraping",
    "swarm",
    "recreation",
    "games"
  ],
  "author": "Finding Sports Team",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "socket.io": "^4.7.2",
    "jsonwebtoken": "^9.0.2",
    "bcrypt": "^5.1.1",
    "google-auth-library": "^9.2.0",
    "axios": "^1.10.0",
    "cheerio": "^1.0.0-rc.12",
    "node-cron": "^3.0.2"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "eslint": "^8.50.0",
    "jest": "^29.7.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}