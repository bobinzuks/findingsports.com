# Finding Sports Environment Variables
# Copy this to Railway Variables tab

# Server Configuration
NODE_ENV=production
PORT=8080
CORS_ORIGIN=https://findingsports.com

# Security
JWT_SECRET=your-super-secure-random-string-at-least-32-chars

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Google Maps API
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Database (optional - if you add one later)
# DATABASE_URL=postgresql://user:password@host:port/dbname

# Redis Cache (optional - for production caching)
# REDIS_URL=redis://user:password@host:port

# OpenAI API (optional - for AI features)
# OPENAI_API_KEY=sk-your-openai-api-key

# Monitoring (optional)
# SENTRY_DSN=https://your-sentry-dsn

# Feature Flags
ENABLE_WEBSOCKET=true
ENABLE_AI_DISCOVERY=false
ENABLE_CACHING=true
CACHE_TTL=3600

# Rate Limiting
RATE_LIMIT_WINDOW=15
RATE_LIMIT_MAX_REQUESTS=100

# Logging
LOG_LEVEL=info

# External APIs (optional)
# WEATHER_API_KEY=your-weather-api-key
# STRIPE_SECRET_KEY=sk_test_your-stripe-key