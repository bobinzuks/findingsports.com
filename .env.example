# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/finding_sports
# For production with SSL:
# DATABASE_URL=postgresql://user:password@host:5432/finding_sports?sslmode=require

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
# For Redis with auth:
# REDIS_URL=redis://:password@localhost:6379

# API Keys
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here
# ACTIVENET_API_KEY=your_activenet_api_key_here
# RECDESK_API_KEY=your_recdesk_api_key_here

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS Configuration
CORS_ORIGIN=*

# Cache Configuration
WARM_CACHE=true

# Security
# JWT_SECRET=your_jwt_secret_here
# SESSION_SECRET=your_session_secret_here

# Email Configuration (for RSS/Email parsing)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_email@gmail.com
# EMAIL_PASS=your_app_password

# Scraping Configuration
HEADLESS_BROWSER=true
SCRAPING_TIMEOUT=30000
SCRAPING_RETRIES=3

# Rate Limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
