{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "npm install && cd finding-sports-react && npm install && npm run build"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "npm start",
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30
  },
  "environments": {
    "production": {
      "build": {
        "buildCommand": "npm install --production && cd finding-sports-react && npm install && npm run build"
      },
      "deploy": {
        "startCommand": "npm start"
      }
    }
  }
}