{
  "$schema": "https://railway.app/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "pip install -r railway-requirements.txt"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "gunicorn railway_integration:app --bind 0.0.0.0:$PORT --workers 1 --timeout 120 --log-level info",
    "restartPolicyType": "on-failure",
    "restartPolicyMaxRetries": 3,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 30
  },
  "environments": {
    "production": {
      "buildCommand": "pip install -r railway-requirements.txt",
      "startCommand": "gunicorn railway_integration:app --bind 0.0.0.0:$PORT --workers 1 --timeout 120 --log-level info"
    }
  }
}