{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "NIXPACKS",
    "buildCommand": "cd mockup/backend && npm install --production"
  },
  "deploy": {
    "numReplicas": 1,
    "startCommand": "cd mockup/backend && node ultra-simple-server.js",
    "restartPolicyType": "NEVER",
    "healthcheckPath": "/api/health",
    "healthcheckTimeout": 30
  }
}